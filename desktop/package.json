{
  "name": "wedecode-desktop",
  "productName": "Wedecode",
  "version": "0.1.0",
  "description": "微信小程序 wxapkg 反编译工具 —— 桌面版",
  "private": true,
  "main": "main.cjs",
  "author": "Fanpeng <976977577@qq.com>",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:app": "electron-builder --dir",
    "build:dmg": "electron-builder --mac dmg",
    "sync:app": "test -d release/Wedecode.app || { echo '未找到 release/Wedecode.app, 请先执行 pnpm build:app'; exit 1; }; cd .. && pnpm build && cd desktop && ditto ../public release/Wedecode.app/Contents/Resources/app/public && ditto ../dist release/Wedecode.app/Contents/Resources/app/dist && codesign --force --deep --sign - release/Wedecode.app && echo 'App 已同步最新前端并重签'"
  },
  "dependencies": {
    "@biggerstar/deepmerge": "^1.0.3",
    "@biggerstar/inquirer-selectable-table": "^1.0.12",
    "axios": "^1.7.4",
    "cheerio": "1.0.0-rc.12",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "escodegen": "^1.14.3",
    "esprima": "^4.0.1",
    "express": "^5.1.0",
    "figlet": "^1.7.0",
    "glob": "^10.4.1",
    "inquirer": "^9.2.23",
    "js-beautify": "^1.15.1",
    "jsdom": "^24.1.0",
    "multer": "^2.0.2",
    "open-file-explorer": "^1.0.2",
    "picocolors": "^1.0.1",
    "single-line-log": "^1.1.2",
    "update-check": "^1.5.4",
    "vm2": "^3.9.19",
    "ws": "^8.18.3",
    "cssbeautify": "^0.3.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.wedecode.desktop",
    "productName": "Wedecode",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app/dist"
      },
      {
        "from": "../public",
        "to": "app/public"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "Wedecode 桌面版"
    }
  },
  "type": "module"
}